# Salin berkas ini menjadi `.env` (TIDAK di-commit), lalu isi. Jangan pernah menulis rahasia di sini.

# Database pengembangan lokal (PostgreSQL). Ganti USER, KATA_SANDI sesuai instalasi Anda.
DATABASE_URL="postgresql://USER:KATA_SANDI@localhost:5432/kds_dev"
# Untuk PostgreSQL lokal isi SAMA dengan DATABASE_URL. (Untuk layanan dengan pooler, mis. Neon,
# isi dengan alamat koneksi langsung tanpa pooler.)
DATABASE_URL_UNPOOLED="postgresql://USER:KATA_SANDI@localhost:5432/kds_dev"

# Database khusus tes integrasi. Nama database WAJIB berakhiran _test (tes menolak yang lain).
TEST_DATABASE_URL="postgresql://USER:KATA_SANDI@localhost:5432/kds_test"

# Dibuat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Gunakan nilai BERBEDA untuk pengembangan dan produksi.
AUTH_SECRET=""

# Akun admin yang dibuat oleh `npm run db:seed` (kata sandi tidak pernah ada di kode).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# KDS2 (kunci jawaban paritas) - HANYA-BACA. Isi bila berbeda dari bawaan.
# KDS2_MYSQL_URL="mysql://root@127.0.0.1:3306/kds2_produksi"
